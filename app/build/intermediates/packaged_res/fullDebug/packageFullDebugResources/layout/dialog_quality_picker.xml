<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioGroup
                android:id="@+id/qualityGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:showDividers="middle"
                android:divider="@drawable/divider_row_gap" />

            <!-- Advanced settings accordion: collapsed header row that
                 expands into the real-format list below it. Kept in the
                 same scrolling column as qualityGroup (rather than a
                 separate fixed-height panel) so once expanded the whole
                 dialog scrolls together instead of nesting two
                 independently-scrolling regions. -->
            <LinearLayout
                android:id="@+id/advancedHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/advancedHeaderText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Advanced"
                    android:textAppearance="@style/TextAppearance.Xmd.Snackbar"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/advancedChevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/advancedContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/advancedProgress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginVertical="12dp" />

                <TextView
                    android:id="@+id/advancedEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Couldn't load extra formats"
                    android:textAppearance="@style/TextAppearance.Xmd.Snackbar"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:visibility="gone" />

                <RadioGroup
                    android:id="@+id/advancedGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:showDividers="middle"
                    android:divider="@drawable/divider_row_gap" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
