<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================
         Material 3 Expressive palette
         Seed: a vivid sky-blue (matches the app's original accent),
         expanded into full tonal roles + a playful tertiary hue for
         expressive accenting (chips, badges, progress, highlights).
         ============================================================ -->

    <!-- Primary (sky blue) -->
    <color name="m3_primary">#7CD4FF</color>
    <color name="m3_on_primary">#00344A</color>
    <color name="m3_primary_container">#00496A</color>
    <color name="m3_on_primary_container">#C7E7FF</color>

    <!-- Secondary (muted teal-slate, for supporting UI) -->
    <color name="m3_secondary">#B7CAD6</color>
    <color name="m3_on_secondary">#22323C</color>
    <color name="m3_secondary_container">#3A4953</color>
    <color name="m3_on_secondary_container">#D3E5F2</color>

    <!-- Tertiary (expressive pop — warm coral, used for highlights/badges) -->
    <color name="m3_tertiary">#FFB4A0</color>
    <color name="m3_on_tertiary">#5C1900</color>
    <color name="m3_tertiary_container">#7D2C0F</color>
    <color name="m3_on_tertiary_container">#FFDBCF</color>

    <!-- Error -->
    <color name="m3_error">#FFB4AB</color>
    <color name="m3_on_error">#690005</color>
    <color name="m3_error_container">#93000A</color>
    <color name="m3_on_error_container">#FFDAD6</color>

    <!-- Success (custom role, M3 supports app-defined extra roles) -->
    <color name="m3_success">#8CDB9C</color>
    <color name="m3_on_success">#003914</color>
    <color name="m3_success_container_solid">#0A5A2A</color>
    <color name="m3_on_success_container">#ABF0B6</color>

    <!-- Warning (custom role) -->
    <color name="m3_warning">#FFD08C</color>
    <color name="m3_on_warning">#452B00</color>
    <color name="m3_warning_container">#623F00</color>
    <color name="m3_on_warning_container">#FFDDB3</color>

    <!-- Neutral surfaces — M3 surface-container tonal ramp -->
    <color name="m3_background">#0E1521</color>
    <color name="m3_on_background">#E1E2E8</color>
    <color name="m3_surface">#0E1521</color>
    <color name="m3_on_surface">#E1E2E8</color>
    <color name="m3_surface_dim">#0E1521</color>
    <color name="m3_surface_bright">#343B47</color>
    <color name="m3_surface_container_lowest">#090E17</color>
    <color name="m3_surface_container_low">#161D2A</color>
    <color name="m3_surface_container">#1A2230</color>
    <color name="m3_surface_container_high">#25303F</color>
    <color name="m3_surface_container_highest">#303B4A</color>
    <color name="m3_on_surface_variant">#C1C8D6</color>
    <color name="m3_outline">#8B93A3</color>
    <color name="m3_outline_variant">#414A5A</color>
    <color name="m3_inverse_surface">#E1E2E8</color>
    <color name="m3_inverse_on_surface">#1A2230</color>
    <color name="m3_inverse_primary">#00658F</color>
    <color name="m3_scrim">#000000</color>
    <color name="m3_shadow">#000000</color>

    <!-- ============================================================
         Legacy aliases — every existing R.color.ff_* reference keeps
         working, remapped onto the new M3 tonal roles above so the
         whole app inherits the new palette without touching every
         call site.
         ============================================================ -->
    <color name="ff_bg">#0E1521</color>
    <color name="ff_surface">#1A2230</color>
    <color name="ff_surface_2">#25303F</color>
    <color name="ff_divider">#414A5A</color>
    <color name="ff_accent">#7CD4FF</color>
    <color name="ff_text">#E1E2E8</color>
    <color name="ff_muted">#C1C8D6</color>
    <color name="ff_success">#8CDB9C</color>
    <color name="ff_error">#FFB4AB</color>
    <color name="ff_warning">#FFD08C</color>

</resources>
