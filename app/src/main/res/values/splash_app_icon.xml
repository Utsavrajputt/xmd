<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- One system splash per launcher icon pair: the icon's background behind its logo. Android 13+ applies the
         one for the chosen icon through LauncherIconManager; older versions keep the default splash. The icon is animated, see drawable/ic_splash_*.xml. -->
    <style name="Theme.Xmd.Splash.BlackColor" parent="Theme.Xmd">
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/icon_bg_black</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">800</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_splash_color</item>
    </style>
