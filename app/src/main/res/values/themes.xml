<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android requires a manifest-time window theme before Compose starts. -->
    <style name="Theme.Xmd" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">#0E1521</item>
        <item name="android:colorBackground">#0E1521</item>
        <item name="android:statusBarColor">#161D2A</item>
        <item name="android:navigationBarColor">#0E1521</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Xmd.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">#FAFAFA</item>
        <item name="android:colorBackground">#FAFAFA</item>
        <item name="android:statusBarColor">#F3F3F6</item>
        <item name="android:navigationBarColor">#FAFAFA</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Xmd.Transparent" parent="Theme.Xmd">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowIsFloating">false</item>
    </style>

</resources>