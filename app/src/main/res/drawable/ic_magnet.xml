<?xml version="1.0" encoding="utf-8"?>
<!-- Magnet-link glyph so the torrent entry point reads as "torrent" at a
     glance instead of a generic "+". Redrawn as a single continuous
     stroked horseshoe (two straight legs joined by a true circular arc,
     with round line caps on the open pole ends) instead of three separate
     rectangular fill pieces, since the old version's sharp-cornered patches
     were what read as "not round". One unbroken path with round caps/joins
     gives a properly smooth silhouette. Single-color stroke so
     `android:tint` / `iconTint` on the consuming view recolors it
     correctly, same as every other icon in this screen. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M5,19 L5,12 A7,7 0 0 1 19,12 L19,19"/>
</vector>
