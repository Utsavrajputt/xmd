<?xml version="1.0" encoding="utf-8"?>
<!-- Was a path-less <vector> (no <path> children at all); looked fine and
     compiled fine, but crashes on some OS/device combos (confirmed:
     Android 11 / Realme RMX2020) with "XmlPullParserException: no path
     defined" during VectorDrawable.inflateChildElements, since an
     entirely empty vector isn't actually valid everywhere despite
     appearing to work in the emulator/preview. A fully-transparent path
     covering the full canvas renders exactly the same as before
     (invisible) while being a genuinely valid vector, and keeps the same
     20dp reserved footprint so unchecked rows don't shift/jump in size
     next to checked ones. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h24v24h-24z" />
</vector>
