<?xml version="1.0" encoding="utf-8"?>
<!-- Root is a FrameLayout (not a single resizing LinearLayout) so bottomNav
     can be pinned to the physical bottom of the screen via layout_gravity,
     sitting outside the part of the tree that shrinks under
     windowSoftInputMode="adjustResize". Previously bottomNav was the last
     child of one resizing LinearLayout, so opening the keyboard shrank the
     whole column and pushed bottomNav up above the keyboard instead of
     staying fixed at the bottom. See MainActivity's insets listener, which
     pads contentColumn's bottom by bottomNav's measured height so content
     never sits underneath it while the keyboard is closed. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Xmd.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <TextView
                android:id="@+id/toolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Xmd.TitleLarge"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingHorizontal="4dp" />
        </androidx.appcompat.widget.Toolbar>

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.Xmd.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:elevation="0dp" />

</FrameLayout>
