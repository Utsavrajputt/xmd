<?xml version="1.0" encoding="utf-8"?>
<!-- Root is a FrameLayout (not a single resizing LinearLayout) so bottomNav
     sits outside contentColumn as its own sibling, pinned to the physical
     bottom via layout_gravity. Note this alone does NOT keep it fixed
     above the keyboard -- windowSoftInputMode="adjustResize" (no
     edge-to-edge) resizes the whole window, not just contentColumn, so
     bottomNav still rides up with the shrinking window edge. MainActivity
     instead hides bottomNav outright (GONE) while the keyboard is open, via
     a global-layout listener on the root content view -- see onCreate.
     The insets listener here pads contentColumn's bottom by the IME height
     while it's open, and back to 0 once it closes. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Xmd.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">

            <TextView
                android:id="@+id/toolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Xmd.TitleLarge"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingHorizontal="4dp" />
        </androidx.appcompat.widget.Toolbar>

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.Xmd.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:elevation="0dp" />

</FrameLayout>
