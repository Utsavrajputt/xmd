<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <RadioGroup
        android:id="@+id/dnsModeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/dnsOptionAdguard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dns_mode_adguard"
            android:textColor="@color/m3_on_surface"
            android:buttonTint="@color/m3_primary"
            android:paddingVertical="8dp" />

        <RadioButton
            android:id="@+id/dnsOptionOff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dns_mode_off"
            android:textColor="@color/m3_on_surface"
            android:buttonTint="@color/m3_primary"
            android:paddingVertical="8dp" />

        <RadioButton
            android:id="@+id/dnsOptionCustom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dns_mode_custom"
            android:textColor="@color/m3_on_surface"
            android:buttonTint="@color/m3_primary"
            android:paddingVertical="8dp" />
    </RadioGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/dnsCustomUrlLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:hint="@string/dns_custom_url_hint"
        app:boxBackgroundMode="outline"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dnsCustomUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
