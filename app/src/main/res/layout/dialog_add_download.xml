<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_download"
                app:tint="@color/m3_primary"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download_dialog_title"
                android:textColor="@color/m3_on_surface"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Link label row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/torrent_dialog_link_label"
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/downloadCopyLinkButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:icon="@drawable/ic_copy"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:iconTint="?attr/colorOnSurfaceVariant"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:contentDescription="@string/torrent_dialog_copy_link" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/downloadPasteLinkButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:icon="@drawable/ic_paste"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="22dp"
                app:iconTint="?attr/colorOnSurfaceVariant"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:contentDescription="@string/dialog_paste_link" />
        </LinearLayout>

        <!-- Link input card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/m3_outline_variant"
            app:cardBackgroundColor="@color/m3_surface_container">

            <EditText
                android:id="@+id/downloadLinkInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="2"
                android:maxLines="4"
                android:gravity="top"
                android:inputType="textMultiLine|textNoSuggestions"
                android:background="@null"
                android:padding="14dp"
                android:hint="@string/download_dialog_link_hint"
                android:textColorHint="@color/m3_on_surface_variant"
                android:textColor="@color/m3_on_surface"
                android:textSize="15sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Pick .torrent file instead -->
        <TextView
            android:id="@+id/downloadPickFileText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/torrent_dialog_pick_file"
            android:textColor="@color/m3_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:padding="6dp" />

        <!-- Name label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/torrent_dialog_name_label"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- Name input card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/m3_outline_variant"
            app:cardBackgroundColor="@color/m3_surface_container">

            <EditText
                android:id="@+id/downloadNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:inputType="text|textNoSuggestions"
                android:background="@null"
                android:padding="14dp"
                android:hint="@string/download_dialog_name_placeholder"
                android:textColorHint="@color/m3_on_surface_variant"
                android:textColor="@color/m3_on_surface"
                android:textSize="15sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Quality & Format section (visible for YouTube & stream links) -->
        <LinearLayout
            android:id="@+id/downloadQualitySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download_dialog_quality_label"
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 1st Dropdown: Video Quality & Audio only -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/downloadQualityLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="@color/m3_outline_variant">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/downloadQualityDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="14sp"
                        android:paddingVertical="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 2nd Dropdown: Audio Formats (shown when Audio only is selected) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/downloadAudioFormatLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:visibility="gone"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="@color/m3_outline_variant">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/downloadAudioFormatDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="14sp"
                        android:paddingVertical="12dp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Collapsible Advanced section -->
        <LinearLayout
            android:id="@+id/downloadAdvancedHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="18dp"
            android:background="?attr/selectableItemBackground"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/torrent_dialog_advanced_label"
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <ImageView
                android:id="@+id/downloadAdvancedChevron"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/m3_on_surface_variant"
                android:rotation="90" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/downloadAdvancedContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp">

            <!-- Save-to row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/torrent_dialog_save_to_label"
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/m3_outline_variant"
                app:cardBackgroundColor="@color/m3_surface_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/downloadSaveToPathText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="13sp"
                        android:maxLines="2"
                        android:ellipsize="middle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/downloadChangePathButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/torrent_dialog_change_path"
                        android:textSize="13sp"
                        android:textColor="@color/m3_primary"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Available Streams Section (Probed via yt-dlp) -->
            <LinearLayout
                android:id="@+id/downloadAdvancedStreamsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download_dialog_advanced_streams_title"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:layout_marginBottom="6dp" />

                <!-- Probing progress -->
                <LinearLayout
                    android:id="@+id/downloadAdvancedStreamsLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/download_dialog_advanced_streams_probing"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textSize="12sp"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        app:trackThickness="4dp"
                        app:indicatorColor="@color/m3_primary"
                        app:trackColor="@color/m3_surface_container_highest" />
                </LinearLayout>

                <!-- Empty text -->
                <TextView
                    android:id="@+id/downloadAdvancedStreamsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/download_dialog_advanced_streams_empty"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:paddingVertical="8dp" />

                <!-- Probed streams scrollable card container -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/downloadAdvancedStreamsCard"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:visibility="gone"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/m3_outline_variant"
                    app:cardBackgroundColor="@color/m3_surface_container">

                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/downloadAdvancedStreamsScroll"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false"
                        android:overScrollMode="never"
                        android:clipToPadding="false"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="4dp">

                        <RadioGroup
                            android:id="@+id/downloadAdvancedStreamsGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </androidx.core.widget.NestedScrollView>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <!-- Action buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="26dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/downloadCancelButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/torrent_dialog_cancel"
                android:textSize="15sp"
                android:textColor="@color/m3_on_surface_variant"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/downloadStartButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/torrent_dialog_start"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
