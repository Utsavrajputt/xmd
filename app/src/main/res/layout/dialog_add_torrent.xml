<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="18dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_magnet"
            android:tint="@color/m3_primary"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/torrent_dialog_title"
            android:textColor="@color/m3_on_surface"
            android:textAppearance="@style/TextAppearance.Xmd.TitleMedium" />
    </LinearLayout>

    <!-- Link label -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/torrent_dialog_link_label"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="11sp"
            android:letterSpacing="0.05" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/torrentCopyLinkButton"
            style="@style/Widget.Xmd.IconButton.Tonal"
            android:layout_width="28dp"
            android:layout_height="28dp"
            app:icon="@drawable/ic_link"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="14dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="@string/torrent_dialog_copy_link" />
    </LinearLayout>

    <!-- Link input card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/m3_surface_container_high"
        app:shapeAppearance="@style/ShapeAppearance.Xmd.Medium"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <EditText
            android:id="@+id/torrentLinkInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:maxLines="4"
            android:gravity="top"
            android:inputType="textMultiLine|textNoSuggestions"
            android:background="@null"
            android:padding="12dp"
            android:hint="@string/torrent_dialog_link_hint"
            android:textColorHint="@color/m3_on_surface_variant"
            android:textColor="@color/m3_on_surface"
            android:textSize="13sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Pick .torrent file instead -->
    <TextView
        android:id="@+id/torrentPickFileText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/torrent_dialog_pick_file"
        android:textColor="@color/m3_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="?attr/selectableItemBackground"
        android:padding="4dp" />

    <!-- Name label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/torrent_dialog_name_label"
        android:textColor="@color/m3_on_surface_variant"
        android:textSize="11sp"
        android:letterSpacing="0.05"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp" />

    <!-- Editable (was a read-only TextView) so the user can rename the
         download before it starts, same as ADM/other external downloaders
         let you retitle a magnet before hitting Start. Still auto-filled
         from the magnet's dn= param via updateNamePreview() in
         HomeFragment, just no longer locked once filled. Uses a hint
         (not hardcoded text) so it stays empty/placeholder until the
         magnet name is actually parsed. -->
    <EditText
        android:id="@+id/torrentNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:padding="0dp"
        android:hint="@string/torrent_dialog_name_placeholder"
        android:textColorHint="@color/m3_on_surface_variant"
        android:textColor="@color/m3_on_surface"
        android:textSize="14sp"
        android:maxLines="2"
        android:inputType="text" />

    <!-- Advanced: collapsed by default, expands to a save-folder override.
         Chevron rotates on toggle to hint expand/collapse state. -->
    <LinearLayout
        android:id="@+id/torrentAdvancedHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingVertical="10dp"
        android:layout_marginTop="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/torrent_dialog_advanced_label"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/torrentAdvancedChevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_arrow_forward"
            android:rotation="90"
            android:tint="@color/m3_on_surface_variant"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/torrentAdvancedContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/torrent_dialog_save_to_label"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="11sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/torrentSaveToPathText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/torrent_dialog_save_to_default"
                android:textColor="@color/m3_on_surface"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="start" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/torrentChangePathButton"
                style="@style/Widget.Xmd.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/torrent_dialog_change_path"
                android:textColor="@color/m3_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/m3_outline_variant"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="4dp" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/torrentCancelButton"
            style="@style/Widget.Xmd.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_cancel"
            android:textColor="@color/m3_on_surface_variant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/torrentStartButton"
            style="@style/Widget.Xmd.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/action_start"
            app:backgroundTint="@color/m3_primary"
            android:textColor="@color/m3_on_primary" />
    </LinearLayout>
</LinearLayout>
