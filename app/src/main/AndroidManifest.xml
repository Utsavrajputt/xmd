<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- libtorrent4j (magnet/torrent downloads) reads the Wi-Fi state to pick
         a network interface for its peer/DHT sockets. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the in-app updater (About screen) launch the system package
         installer for a downloaded APK on Android 8+, where installing
         from an "unknown source" needs this explicit grant instead of the
         old device-wide toggle. If not yet granted, firing the install
         intent still works - Android routes the user to the "allow
         installs from this app" system screen first, same as mpvRx. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Storage: legacy for Android 8-9, MANAGE_EXTERNAL_STORAGE for Android 10+ -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:name=".FfApp"
        android:allowBackup="true"
        android:icon="@mipmap/xmd"
        android:roundIcon="@mipmap/xmd"
        android:label="@string/app_name"
        android:theme="@style/Theme.Xmd"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Handles "Share" -> xmd for a copied/shared link (e.g. YouTube,
             Chrome, etc.), external download manager requests from browsers
             (Firefox, Vivaldi), and magnet/.torrent links without bringing
             MainActivity to the foreground. Shows a floating dialog over the
             caller's app and starts downloads in the background. -->
        <activity
            android:name=".ui.ShareReceiverActivity"
            android:theme="@style/Theme.Xmd.Transparent"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Lets browsers (Firefox, Vivaldi, etc.) offer xmd as an
                 "external download manager" / open-with target when a
                 download link is tapped. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- magnet: links tapped in browsers, torrent-search apps, etc. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>

            <!-- Direct .torrent file links/downloads. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ChallengeActivity"
            android:exported="false"
            android:label="@string/challenge_title" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!-- Chrome-less standalone window for "Add to Home screen" pinned
             shortcuts (see BrowserFragment.addCurrentPageAsApp()). exported
             is required here: the pinned icon is launched by the system
             launcher, a different app/process, so the target activity must
             be reachable from outside xmd itself. taskAffinity="" keeps
             every pinned site off MainActivity's own task, and
             documentLaunchMode="intoExisting" gives each distinct pinned
             URL its own recents entry (reusing that same entry on repeat
             launches of the same site) instead of two different pinned
             sites colliding into one shared task. -->
        <activity
            android:name=".ui.WebAppActivity"
            android:exported="true"
            android:taskAffinity=""
            android:documentLaunchMode="intoExisting" />

        <!-- Fires only once a pinned shortcut is actually placed by the
             launcher (see PinnedShortcutReceiver's doc comment) -- not
             exported since only our own PendingIntent, passed straight to
             ShortcutManagerCompat, ever targets it. -->
        <receiver
            android:name=".ui.browser.PinnedShortcutReceiver"
            android:exported="false" />

        <service
            android:name=".service.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Lets DownloadsFragment's "Open" button hand a completed file to
             an external app via a content:// URI instead of a raw file://
             one, required on Android 7+ (FileUriExposedException) and the
             only way to grant a specific other app temporary read access to
             a file under our own external storage path. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
